{
  "name": "aisafetycom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "check:icons": "node scripts/check-icon-sizes.mjs",
    "prebuild": "node scripts/check-icon-sizes.mjs && node scripts/pin-preview-keys.mjs",
    "build": "vitest run && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.0",
    "@types/d3": "^7.4.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/blob": "^2.7.0",
    "airtable": "^0.12.2",
    "d3": "^7.9.0",
    "franc-min": "^6.2.0",
    "next": "^16.3.4",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.25",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.10.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.1.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
