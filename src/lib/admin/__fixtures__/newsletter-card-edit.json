ober at the latest<!--/f--></td></tr></table><!--[if !mso]><!--></a><!--<![endif]--></td></tr>\n</table><!--/card-->\n\n  \n<div style=\"margin-top:24px;border-top:1px solid #1c3334;\"></div>\n<div style=\"margin-top:24px;font-family:Inter, -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif;font-size:13px;line-height:22px;mso-line-height-rule:exactly;font-weight:300;letter-spacing:0px;color:#aab2b3;\">\n  <a href=\"%UNSUBSCRIBELINK%\" class=\"fl\" style=\"color:#aab2b3;text-decoration:underline;text-decoration-color:#325354;\">Unsubscribe</a>\n  &nbsp;&middot;&nbsp; <a href=\"%WEBCOPY%\" class=\"fl\" style=\"color:#aab2b3;text-decoration:underline;text-decoration-color:#325354;\">View in browser</a>\n</div>\n<div style=\"margin-top:8px;font-family:Inter, -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif;font-size:12px;line-height:20px;mso-line-height-rule:exactly;font-weight:300;letter-spacing:0px;color:#556667;\">%SENDER-INFO-SINGLELINE%</div>\n\n</td></tr>\n</table>\n<!--[if mso]></td></tr></table><![endif]-->\n</td></tr>\n</table>\n<!--aisafety-cards:-->\n</body>\n</html>",
